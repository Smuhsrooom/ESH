{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESH Chat",
  "version": "0.1.0",
  "identifier": "local.esh.conversation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"ESH · AI 협업","width":1600,"height":900,"minWidth":900,"minHeight":600,"center":true,"zoomHotkeysEnabled":true}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"}
  },
  "bundle": {"active":false}
}
